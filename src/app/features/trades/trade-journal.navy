// Navy ~ 0.2-lite
//
// TradeJournal — сделка на свечах в языке журнала (референс — digash
// UserTrades, перенесено из diops): пунктирные ступенчатые линии бегущей
// средней цены — отдельно по входам и по выходам (шагают на каждом исполнении,
// тянутся до правого края); рисуются только при 2+ исполнениях на стороне.
// Маркер-шеврон на КАЖДОМ исполнении на цене исполнения (покупка ▲, продажа ▼)
// с пунктирной горизонтальной линией к правому краю (оси Y). Пилюля результата
// у правого края на уровне средней цены выхода.

[OVERLAY name=TradeJournal, ctx=Canvas, version=1.3.0]

prop('entryLine', { type: 'array', def: [] })
prop('exitLine', { type: 'array', def: [] })
prop('markers', { type: 'array', def: [] })
prop('entryColor', { type: 'Color', def: '#3fb950' })
prop('exitColor', { type: 'Color', def: '#f85149' })
prop('buyColor', { type: 'Color', def: '#3fb950' })
prop('sellColor', { type: 'Color', def: '#f85149' })
prop('pnlColor', { type: 'Color', def: '#3fb950' })
prop('onColor', { type: 'Color', def: '#08090a' })
prop('backColor', { type: 'Color', def: '#08090a' })
prop('exitPrice', { type: 'number', def: 0 })
prop('pnlLabel', { type: 'string', def: '' })

draw(ctx) {
    const layout = $core.layout
    const data = $core.data
    if (!data || data.length < 2) { return }
    const w = layout.width

    ctx.save()
    ctx.font = '510 11px "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace'
    ctx.textBaseline = 'middle'
    ctx.lineJoin = 'round'
    ctx.lineCap = 'round'

    stepLine(ctx, layout, data, w, $props.entryLine || [], $props.entryColor)
    stepLine(ctx, layout, data, w, $props.exitLine || [], $props.exitColor)

    const markers = $props.markers || []
    for (let k = 0; k < markers.length; k++) {
        const idx = markers[k][0]
        const dir = markers[k][1]
        const price = markers[k][2]
        const p = data[idx]
        if (!p) { continue }
        const x = layout.ti2x(p[0], idx)
        const y = layout.value2y(price)
        const color = dir > 0 ? $props.buyColor : $props.sellColor
        markerLine(ctx, x, y, w, color)
        chevron(ctx, x, y, dir > 0, color, $props.backColor)
    }

    if ($props.exitPrice) {
        badge(ctx, w, layout.value2y($props.exitPrice), $props.pnlLabel, $props.pnlColor, $props.onColor)
    }
    ctx.restore()
}

stepLine(ctx, layout, data, w, pts, color) {
    if (!pts || pts.length < 2) { return }
    ctx.save()
    ctx.strokeStyle = color
    ctx.lineWidth = 1.5
    ctx.setLineDash([5, 4])
    ctx.globalAlpha = 0.9
    ctx.beginPath()
    let prevY = 0
    for (let k = 0; k < pts.length; k++) {
        const idx = pts[k][0]
        const p = data[idx]
        const x = p ? layout.ti2x(p[0], idx) : 0
        const y = layout.value2y(pts[k][1])
        if (k === 0) {
            ctx.moveTo(x, y)
        } else {
            ctx.lineTo(x, prevY)
            ctx.lineTo(x, y)
        }
        prevY = y
    }
    ctx.lineTo(w, prevY)
    ctx.stroke()
    ctx.restore()
}

markerLine(ctx, x, y, w, color) {
    ctx.save()
    ctx.strokeStyle = color
    ctx.lineWidth = 1
    ctx.setLineDash([4, 4])
    ctx.globalAlpha = 0.45
    ctx.beginPath()
    ctx.moveTo(x + 10, y)
    ctx.lineTo(w, y)
    ctx.stroke()
    ctx.restore()
}

chevron(ctx, x, y, up, color, back) {
    const size = 7
    ctx.save()
    ctx.lineJoin = 'round'
    ctx.lineCap = 'round'
    ctx.beginPath()
    if (up) {
        ctx.moveTo(x - size, y + size)
        ctx.lineTo(x, y)
        ctx.lineTo(x + size, y + size)
    } else {
        ctx.moveTo(x - size, y - size)
        ctx.lineTo(x, y)
        ctx.lineTo(x + size, y - size)
    }
    ctx.strokeStyle = back || '#08090a'
    ctx.lineWidth = 5.5
    ctx.stroke()
    ctx.strokeStyle = color
    ctx.lineWidth = 2.8
    ctx.stroke()
    ctx.restore()
}

badge(ctx, w, y, text, fill, textColor) {
    if (!text) { return }
    const tw = ctx.measureText(text).width + 18
    const x = w - tw - 6
    ctx.beginPath()
    ctx.moveTo(x + 4, y - 10)
    ctx.arcTo(x + tw, y - 10, x + tw, y + 10, 4)
    ctx.arcTo(x + tw, y + 10, x, y + 10, 4)
    ctx.arcTo(x, y + 10, x, y - 10, 4)
    ctx.arcTo(x, y - 10, x + tw, y - 10, 4)
    ctx.closePath()
    ctx.fillStyle = fill
    ctx.fill()
    ctx.fillStyle = textColor
    ctx.textAlign = 'center'
    ctx.fillText(text, x + tw / 2, y + 0.5)
}

// hi/lo не используем: автодиапазон night-vision включает колонку объёма.
// Заявляем только цены исполнений — свечной диапазон даст объединение
// с оверлеем Candles.
yRange(data, hi, lo) {
    const markers = $props.markers || []
    if (!markers.length) { return [hi, lo] }
    let top = -Infinity
    let bottom = Infinity
    for (let k = 0; k < markers.length; k++) {
        const price = markers[k][2]
        if (price > top) { top = price }
        if (price < bottom) { bottom = price }
    }
    return [top * 1.004, bottom * 0.996]
}

legend(x) => []
